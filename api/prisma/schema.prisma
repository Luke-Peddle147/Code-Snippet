generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Snippet {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  language    String
  code        String
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  snippets Snippet[]
}